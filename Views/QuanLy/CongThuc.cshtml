@model CongThucVM
@{
    ViewData["Title"] = "Công thức: " + Model.MonAn.TenMon;
    Layout = "_StaffLayout";
}
@if (Model.DanhSachKichCoMon.Count > 0)
{
    <div class="panel" style="margin-bottom:1rem">
        <p class="muted" style="margin:0 0 .6rem">Món này có nhiều size - mỗi size cần khai báo công thức riêng:</p>
        <div class="actions">
            @foreach (var kc in Model.DanhSachKichCoMon)
            {
                <a class="btn btn-sm @(Model.MaKichCo == kc.MaKichCo ? "" : "btn-ghost")" asp-action="CongThuc" asp-route-ma="@Model.MonAn.MaMonAn" asp-route-maKichCo="@kc.MaKichCo">Size @kc.TenKichCo</a>
            }
        </div>
    </div>
}
<div class="panel">
    <p class="muted">Nhập lượng nguyên liệu dùng cho <strong>1 phần</strong>@(Model.MaKichCo != null ? $" (size {Model.DanhSachKichCoMon.First(k => k.MaKichCo == Model.MaKichCo).TenKichCo})" : ""). Để 0 nếu món không dùng nguyên liệu đó. Kho sẽ tự trừ theo công thức khi thu ngân bấm "Nhận đơn và làm".</p>
    <form asp-action="CongThuc" method="post">
        <input type="hidden" name="ma" value="@Model.MonAn.MaMonAn" />
        <input type="hidden" name="maKichCo" value="@Model.MaKichCo" />
        <div class="table-wrap"><table class="tbl" style="max-width:640px">
            <tr><th>Nguyên liệu</th><th>Lượng dùng</th><th>Đơn vị</th></tr>
            @foreach (var nl in Model.DanhSachNguyenLieu)
            {
                var luong = Model.DangDung.GetValueOrDefault(nl.MaNguyenLieu);
                <tr>
                    <td>@nl.TenNguyenLieu</td>
                    <td><input type="hidden" name="danhSachMaNguyenLieu" value="@nl.MaNguyenLieu" />
                        <input class="input" style="width:130px" type="number" step="0.001" min="0" name="danhSachSoLuong" value="@luong.SoThapPhan()" /></td>
                    <td>@nl.DonViTinh</td>
                </tr>
            }
        </table></div>
        <div class="actions" style="margin-top:1rem"><button class="btn" type="submit">Lưu công thức</button><a class="btn btn-ghost" asp-action="DanhSachMon">Quay lại</a></div>
    </form>
</div>
