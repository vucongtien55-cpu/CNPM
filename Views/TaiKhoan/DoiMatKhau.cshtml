@model DoiMatKhauVM
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_StaffLayout";
}
<div class="panel">
    <form asp-action="DoiMatKhau" method="post" class="form-grid">
        <div asp-validation-summary="ModelOnly" class="err"></div>
        <div class="field"><label asp-for="MatKhauHienTai">Mật khẩu hiện tại</label><input asp-for="MatKhauHienTai" type="password" class="input" autocomplete="current-password" /><span asp-validation-for="MatKhauHienTai" class="err"></span></div>
        <div class="field"><label asp-for="MatKhauMoi">Mật khẩu mới (tối thiểu 8 ký tự)</label><input asp-for="MatKhauMoi" type="password" class="input" autocomplete="new-password" /><span asp-validation-for="MatKhauMoi" class="err"></span></div>
        <div class="field"><label asp-for="NhapLaiMatKhau">Nhập lại mật khẩu mới</label><input asp-for="NhapLaiMatKhau" type="password" class="input" autocomplete="new-password" /><span asp-validation-for="NhapLaiMatKhau" class="err"></span></div>
        <div class="actions"><button class="btn" type="submit">Lưu mật khẩu mới</button></div>
    </form>
</div>
