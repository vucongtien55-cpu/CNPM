@model DangNhapVM
@{
    Layout = null;
    var tenQuan = CauHinh["CuaHang:Ten"] ?? "MIXUE";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập nhân viên - @tenQuan</title>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrap">
        <div class="login-card">
            <h1>☃️ @tenQuan</h1>
            <p class="muted">Đăng nhập dành cho thu ngân và quản lý.</p>
            @if (TempData["ThanhCong"] != null)
            {
                <div class="ok">@TempData["ThanhCong"]</div>
            }
            <form asp-action="DangNhap" method="post">
                <input type="hidden" asp-for="DuongDanQuayLai" />
                <div asp-validation-summary="ModelOnly" class="err"></div>
                <div class="field">
                    <label asp-for="TenDangNhap">Tên đăng nhập</label>
                    <input asp-for="TenDangNhap" class="input" autocomplete="username" autofocus />
                    <span asp-validation-for="TenDangNhap" class="err"></span>
                </div>
                <div class="field">
                    <label asp-for="MatKhau">Mật khẩu</label>
                    <input asp-for="MatKhau" type="password" class="input" autocomplete="current-password" />
                    <span asp-validation-for="MatKhau" class="err"></span>
                </div>
                <label class="check"><input type="checkbox" asp-for="GhiNho" /> Ghi nhớ đăng nhập trên máy này</label>
                <button class="btn btn-lg" type="submit">Đăng nhập</button>
            </form>
            <p style="margin:.75rem 0 0"><a asp-action="QuenMatKhau">Quên mật khẩu?</a></p>
            <p style="margin:.25rem 0 0"><a asp-controller="TrangChu" asp-action="Index">Về trang khách hàng</a></p>
        </div>
    </div>
</body>
</html>
