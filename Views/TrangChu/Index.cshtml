@model TrangChuVM
@{
    ViewData["Title"] = "Kem tươi & trà mát cực";
    var tenQuan = CauHinh["CuaHang:Ten"] ?? "MIXUE";
}

<section class="hero">
    <div class="container hero-grid">
        <div>
            <h1>Hè nóng nực,<br />trà mát cực</h1>
            <p class="lead">Quét mã QR trên bàn, chọn món và gửi đơn. Thu ngân nhận đơn ngay và pha đồ cho bạn.</p>
            <div class="hero-actions">
                <a class="btn btn-white btn-lg" asp-controller="ThucDon" asp-action="Index">Xem thực đơn và đặt món</a>
                <a class="btn btn-outline-white btn-lg" href="#cach-dat">Cách đặt món</a>
            </div>
        </div>
        <div class="hero-art" aria-hidden="true">
            <svg viewBox="0 0 420 470" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="milk" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#FFF7EA" /><stop offset=".5" stop-color="#F3DDBF" /><stop offset="1" stop-color="#C69566" />
                    </linearGradient>
                    <clipPath id="cupClip"><path d="M92 164 L328 164 L300 420 Q298 436 282 436 L138 436 Q122 436 120 420 Z" /></clipPath>
                </defs>
                <rect x="222" y="14" width="20" height="160" rx="9" fill="#E4002B" transform="rotate(12 232 100)" />
                <path d="M84 152 Q84 80 210 72 Q336 80 336 152 Z" fill="#fff" fill-opacity=".55" stroke="#fff" stroke-width="4" />
                <rect x="78" y="142" width="264" height="24" rx="12" fill="#fff" />
                <path d="M92 164 L328 164 L300 420 Q298 436 282 436 L138 436 Q122 436 120 420 Z" fill="url(#milk)" />
                <g clip-path="url(#cupClip)">
                    <path d="M104 182 C138 226 108 262 132 304 S118 364 134 412" stroke="#5B3421" stroke-width="11" fill="none" opacity=".55" stroke-linecap="round" />
                    <path d="M316 182 C286 232 312 268 290 310 S304 366 290 412" stroke="#5B3421" stroke-width="9" fill="none" opacity=".45" stroke-linecap="round" />
                    <path d="M206 196 C220 240 196 270 214 312" stroke="#5B3421" stroke-width="7" fill="none" opacity=".35" stroke-linecap="round" />
                    <g fill="#2A1A12">
                        <circle cx="142" cy="404" r="14" /><circle cx="171" cy="408" r="14" /><circle cx="200" cy="405" r="14" /><circle cx="229" cy="408" r="14" /><circle cx="258" cy="405" r="14" /><circle cx="285" cy="407" r="13" />
                        <circle cx="156" cy="379" r="14" /><circle cx="185" cy="382" r="14" /><circle cx="214" cy="378" r="14" /><circle cx="243" cy="382" r="14" /><circle cx="271" cy="380" r="13" />
                        <circle cx="170" cy="354" r="14" /><circle cx="199" cy="357" r="14" /><circle cx="228" cy="353" r="14" /><circle cx="257" cy="357" r="13" />
                    </g>
                    <g fill="#fff" fill-opacity=".28">
                        <circle cx="137" cy="399" r="4" /><circle cx="195" cy="400" r="4" /><circle cx="251" cy="400" r="4" /><circle cx="151" cy="374" r="4" /><circle cx="209" cy="373" r="4" /><circle cx="165" cy="349" r="4" /><circle cx="223" cy="348" r="4" />
                    </g>
                </g>
                <path d="M104 268 L316 268 L310 332 L110 332 Z" fill="#E4002B" />
                <text x="210" y="313" text-anchor="middle" font-family="Baloo 2, sans-serif" font-weight="800" font-size="38" fill="#fff">Trà mát cực</text>

                <g class="bubble-float b1"><circle cx="64" cy="118" r="44" fill="#E4002B" stroke="#fff" stroke-width="5" /><text x="64" y="132" text-anchor="middle" font-family="Baloo 2, sans-serif" font-weight="800" font-size="38" fill="#fff">25K</text></g>
                <g class="bubble-float b2"><circle cx="362" cy="238" r="40" fill="#E4002B" stroke="#fff" stroke-width="5" /><text x="362" y="251" text-anchor="middle" font-family="Baloo 2, sans-serif" font-weight="800" font-size="34" fill="#fff">22K</text></g>
                <g class="bubble-float b3"><circle cx="58" cy="392" r="36" fill="#FFD23F" stroke="#fff" stroke-width="5" /><text x="58" y="404" text-anchor="middle" font-family="Baloo 2, sans-serif" font-weight="800" font-size="30" fill="#14284B">15K</text></g>
            </svg>
        </div>
    </div>
</section>

<section class="section" id="ban-chay">
    <div class="container">
        <div class="section-head">
            <h2>Món bán chạy nhất</h2>
            <p>Những ly khách gọi nhiều nhất tại quán. Chọn ngay trong thực đơn, tùy chỉnh đá, đường và topping.</p>
        </div>
        <div class="grid-products">
            @foreach (var mon in Model.MonNoiBat)
            {
                var mauNen = ((mon.MaNhomMon - 1) % 4) + 1;
                <article class="p-card">
                    <span class="tag-best">Bán chạy</span>
                    <div class="price-bubble" title="@mon.Gia.Tien()">@mon.Gia.TienRutGon()</div>
                    <div class="p-media tint-@mauNen">
                        @if (!string.IsNullOrEmpty(mon.DuongDanAnh)) { <img src="@mon.DuongDanAnh" alt="@mon.TenMon" loading="lazy" /> }
                        else { <span class="emoji" aria-hidden="true">@(mon.NhomMon?.BieuTuong ?? "🧋")</span> }
                    </div>
                    <div class="p-body">
                        <h3 class="p-name">@mon.TenMon</h3>
                        <p class="p-en">@mon.TenTiengAnh</p>
                        <div class="danh-gia"><partial name="_DanhGiaSao" model="@(Model.ThongKe.GetValueOrDefault(mon.MaMonAn) ?? new ThongKeDanhGia())" /></div>
                        <a class="btn btn-ghost btn-sm" asp-controller="ThucDon" asp-action="Index" asp-fragment="nhom-@mon.MaNhomMon">Chọn món này</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-sky" id="cach-dat">
    <div class="container">
        <div class="section-head"><h2>Đặt món tại bàn trong 3 bước</h2></div>
        <div class="steps">
            <div class="step"><h3>Quét mã QR trên bàn</h3><p class="muted">Mỗi bàn có một mã QR riêng. Đơn của bạn sẽ được gửi đúng bàn, không cần gọi nhân viên.</p></div>
            <div class="step"><h3>Chọn món và tùy chỉnh</h3><p class="muted">Chọn lượng đá, lượng đường, thêm topping 3K mỗi phần. Giá hiển thị rõ trước khi gửi.</p></div>
            <div class="step"><h3>Gửi đơn và theo dõi</h3><p class="muted">Xem trạng thái đơn theo thời gian thực: đang pha chế, sẵn sàng, hoàn thành. Thanh toán tại quầy.</p></div>
        </div>
    </div>
</section>

<section class="section" id="ve-quan">
    <div class="container about">
        <div>
            <h2>Về quán @tenQuan</h2>
            <p>Chúng mình phục vụ kem tươi, trà sữa và trà hoa quả với mức giá dễ chịu, từ ly kem ốc quế 10K đến ly trà sữa trân châu đường đen 25K.</p>
            <p>Website này giúp bạn gọi món ngay tại chỗ ngồi, chọn đúng vị mình thích và không phải xếp hàng chờ gọi món.</p>
            <a class="btn" asp-controller="ThucDon" asp-action="Index">Xem thực đơn</a>
        </div>
        <div class="about-card">
            <dl>
                <div><dt>Địa chỉ</dt><dd>@CauHinh["CuaHang:DiaChi"]</dd></div>
                <div><dt>Giờ mở cửa</dt><dd>@CauHinh["CuaHang:GioMoCua"]</dd></div>
                <div><dt>Hotline</dt><dd>@CauHinh["CuaHang:SoDienThoai"]</dd></div>
            </dl>
        </div>
    </div>
</section>
